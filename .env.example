# FoodAI Service — variables de entorno.
# Puerto 8010: 8000 lo ocupa el ai-service (agente IA de CoppAddresd).
# El contenedor expone 8000 interno; el compose mapea 8010:8000.

FOOD_AI_API_TITLE=FoodAI Service
FOOD_AI_API_VERSION=0.1.0
FOOD_AI_API_ENVIRONMENT=development
FOOD_AI_SERVICE_PORT=8010

# === Modelo de detección ===
FOOD_AI_MODEL_PATH=weights/yolo11n.pt
FOOD_AI_MODEL_VERSION=food-detector-v1
FOOD_AI_CONFIDENCE_THRESHOLD=0.35
FOOD_AI_IMAGE_SIZE=640
FOOD_AI_DEVICE=cpu
FOOD_AI_MAX_DETECTIONS=20

# Directorio para imágenes de debug (bbox + labels). Vacío = off.
FOOD_AI_DEBUG_IMAGES_DIR=FOOD_AI_SEG_MODEL_PATH=weights/yolo11n-seg.pt
FOOD_AI_SEG_MODEL_VERSION=food-segmenter-v1
