# FoodAI Service — variables de entorno.
# Puerto 8010: 8000 lo ocupa el ai-service (agente IA de CoppAddresd).
# El contenedor expone 8000 interno; el compose mapea 8010:8000.

FOOD_AI_API_TITLE=FoodAI Service
FOOD_AI_API_VERSION=0.1.0
FOOD_AI_API_ENVIRONMENT=development
FOOD_AI_SERVICE_PORT=8010

# === Modelo de detección ===
FOOD_AI_MODEL_PATH=weights/yolo11n.pt
FOOD_AI_MODEL_VERSION=food-detector-v1
FOOD_AI_CONFIDENCE_THRESHOLD=0.35
FOOD_AI_IMAGE_SIZE=640
FOOD_AI_DEVICE=cpu
FOOD_AI_MAX_DETECTIONS=20

# === Modelo de segmentación ===
FOOD_AI_SEG_MODEL_PATH=weights/yolo11n-seg.pt
FOOD_AI_SEG_MODEL_VERSION=food-segmenter-v1

# === Clasificador (sin modelo propio; usa la clase del detector) ===
FOOD_AI_CLASSIFIER_VERSION=detector-based-v1

# Directorio para imágenes de debug (bbox + labels + máscara). Vacío = off.
FOOD_AI_DEBUG_IMAGES_DIR=FOOD_AI_PORTION_METHOD=basic
FOOD_AI_DEPTH_ENABLED=true
FOOD_AI_DEPTH_MODEL_PATH=depth-anything/Depth-Anything-V2-Small-hf
FOOD_AI_DEPTH_MODEL_VERSION=depth-anything-v2-small
FOOD_AI_DEPTH_DEVICE=cpu
FOOD_AI_CLASSIFIER_TYPE=detector_based
FOOD_AI_CLIP_MODEL=openai/clip-vit-base-patch32
FOOD_AI_CLIP_DEVICE=cpu
FOOD_AI_CLIP_THRESHOLD=0.22
FOOD_AI_CLIP_PROMPT_TEMPLATE=a photo of {food}
FOOD_AI_CLIP_CROP_PADDING=0.0
FOOD_AI_CLIP_PROMPT_ENSEMBLE=a picture of {food}|a close-up photo of {food}

FOODAI_USDA_API_KEY=your_usda_api_key_here
